# One Dockerfile for every zone:  docker build -f frontend/Dockerfile --build-arg ZONE=patient-access-frontend frontend
FROM node:20-alpine AS build
ARG ZONE
# The browser calls the microservices directly, so these must be URLs the BROWSER can reach.
ARG NEXT_PUBLIC_PATIENT_ACCESS_API=http://localhost:5001
ARG NEXT_PUBLIC_CLINICAL_CARE_API=http://localhost:5002
ARG NEXT_PUBLIC_LABORATORY_API=http://localhost:5003
ARG NEXT_PUBLIC_REVENUE_CYCLE_API=http://localhost:5006
ARG NEXT_PUBLIC_IDENTITY_ORG_API=http://localhost:5010
ARG NEXT_PUBLIC_INTEGRATION_API=http://localhost:5011
# Shell only: where the zones live (read at build time by next.config.js rewrites)
ARG PATIENT_ACCESS_ZONE_URL=http://localhost:3001
ARG CLINICAL_CARE_ZONE_URL=http://localhost:3002
ARG LABORATORY_ZONE_URL=http://localhost:3003
ARG REVENUE_CYCLE_ZONE_URL=http://localhost:3006
ENV NEXT_PUBLIC_PATIENT_ACCESS_API=$NEXT_PUBLIC_PATIENT_ACCESS_API NEXT_PUBLIC_CLINICAL_CARE_API=$NEXT_PUBLIC_CLINICAL_CARE_API \
    NEXT_PUBLIC_LABORATORY_API=$NEXT_PUBLIC_LABORATORY_API NEXT_PUBLIC_REVENUE_CYCLE_API=$NEXT_PUBLIC_REVENUE_CYCLE_API \
    NEXT_PUBLIC_IDENTITY_ORG_API=$NEXT_PUBLIC_IDENTITY_ORG_API NEXT_PUBLIC_INTEGRATION_API=$NEXT_PUBLIC_INTEGRATION_API \
    PATIENT_ACCESS_ZONE_URL=$PATIENT_ACCESS_ZONE_URL CLINICAL_CARE_ZONE_URL=$CLINICAL_CARE_ZONE_URL \
    LABORATORY_ZONE_URL=$LABORATORY_ZONE_URL REVENUE_CYCLE_ZONE_URL=$REVENUE_CYCLE_ZONE_URL
WORKDIR /app
COPY ${ZONE}/package.json ./
RUN npm install
COPY ${ZONE}/ ./
RUN npm run build

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app ./
CMD ["npm", "start"]
