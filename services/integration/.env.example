# Copy to .env (or export) before `uvicorn app.main:app --port 5011`
DATABASE_URL=postgresql://hims:hims@localhost:5432/hims_integration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F
RABBITMQ_ENABLED=true
HAPI_FHIR_URL=http://103.169.179.22:50060/fhir
FHIR_SYNC_ENABLED=true

# Open Integration Engine (leave ENGINE_URL empty to skip channel provisioning)
ENGINE_URL=https://localhost:8443
ENGINE_USER=admin
ENGINE_PASSWORD=admin
ENGINE_VERIFY_TLS=false
ENGINE_TEMPLATE_CHANNEL=HIMS-Analyzer-Template
ENGINE_FIRST_LISTEN_PORT=6661
HUB_PUBLIC_URL=http://localhost:5011

DEVICE_TIMEZONE=Asia/Kolkata
ENABLE_SIMULATOR=true
PAYLOAD_DIR=./data/payloads
