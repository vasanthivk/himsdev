# ---------- Environment files (all applications) ----------
.env
.env.*
!.env.example

# ---------- Frontend: node_modules in every application ----------
frontend/*/node_modules/

# ---------- Frontend: Next.js build output in every application ----------
frontend/*/.next/

# ---------- Services: build output in every application ----------
services/*/bin/
services/*/obj/

# ---------- Services: appsettings.json in every application ----------
services/*/appsettings.json

# ---------- Shared: build output in every project ----------
shared/*/bin/
shared/*/obj/

# ---------- Visual Studio cache folders (all applications) ----------
.vs/

# ---------- Integration service (Python) ----------
services/integration/.venv/
services/integration/venv/
services/integration/**/__pycache__/
services/integration/data/payloads/*.txt

# ---------- PID files ----------
.pids/*.pid

# ---------- Log files (logs folder and its subfolders) ----------
logs/**/*.log

# ---------- Zip files (entire hims application) ----------
*.zip

# ---------- Config files: frontend and services folders ----------
config/frontend/
config/services/

# ---------- Local TLS certificate for the backend HTTPS ports (contains the private key) ----------
certs/

# ---------- Next.js dev HTTPS certificate (frontend/<app>/certificates, created by --experimental-https; contains a private key) ----------
frontend/*/certificates/
config/certificates/

# ---------- Backups written by config/copy_to_app.sh (contain passwords and keys) ----------
config/backup/
